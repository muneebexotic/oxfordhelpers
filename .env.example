# Copy to .env and fill in. Never commit .env.
# Values marked [build] are baked into the static pages: rebuild after changing them.

# ---- Site identity [build] ----
# oxfordhelpers.co.uk or cambridgehelpers.co.uk. Brand name follows automatically.
SITE_DOMAIN=oxfordhelpers.co.uk
# Optional override of the brand name derived from the domain.
BRAND_NAME=

# ---- Contact details [build] (empty values hide the related buttons) ----
CONTACT_EMAIL=hello@oxfordhelpers.co.uk
# WhatsApp number, international format, digits only, e.g. 447700900123
CONTACT_WHATSAPP=
# Display format, e.g. +44 7700 900123
CONTACT_PHONE=
CONTACT_HOURS=Monday to Saturday, 9am to 8pm (UK time)
# Shown as "We aim to reply ..." - only promise what you can meet.
REPLY_TARGET=within one working day

# ---- Business details [build] (only set what is true) ----
BUSINESS_LEGAL_NAME=
BUSINESS_COMPANY_NUMBER=
BUSINESS_ADDRESS=
BUSINESS_ICO_NUMBER=

# ---- Social profiles and search console verification [build] ----
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Data retention [build + runtime] ----
# Days before personal data in enquiries is purged (also shown in the privacy notice).
RETENTION_DAYS=180

# ---- Server (runtime only) ----
# Long random password for /admin/ (leave empty to disable the dashboard).
ADMIN_PASSWORD=
# Random 32+ character string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Set to 1 when running behind Caddy/another reverse proxy.
TRUST_PROXY=1

# ---- Email notifications (optional, any SMTP provider) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Oxford Helpers <no-reply@oxfordhelpers.co.uk>
# Where new-enquiry notifications go.
NOTIFY_EMAIL=
# 1 = send the visitor an acknowledgement email with their reference.
AUTO_REPLY=0

# ---- Caddy (TLS certificates) ----
ACME_EMAIL=
