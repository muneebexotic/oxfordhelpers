# Build-time settings, baked into the static pages: rebuild after changing them.
# Copy to .env for local builds (never commit .env). Runtime secrets go in .dev.vars
# locally and `npx wrangler secret put` in production; see README.

# ---- Site identity [build] ----
# oxfordhelpers.co.uk or cambridgehelpers.co.uk. Brand name follows automatically.
SITE_DOMAIN=oxfordhelpers.co.uk
# Optional override of the brand name derived from the domain.
BRAND_NAME=

# ---- Contact details [build] (empty values hide the related buttons) ----
CONTACT_EMAIL=hello@oxfordhelpers.co.uk
# WhatsApp number, international format, digits only, e.g. 447700900123 (default in site.config.mjs)
CONTACT_WHATSAPP=
# Display format, e.g. +44 7700 900123
CONTACT_PHONE=
CONTACT_HOURS=Monday to Saturday, 9am to 8pm (UK time)
# Shown as "We aim to reply ..." - only promise what you can meet.
REPLY_TARGET=within one working day

# ---- Business details [build] (only set what is true) ----
BUSINESS_LEGAL_NAME=
BUSINESS_COMPANY_NUMBER=
BUSINESS_ADDRESS=
BUSINESS_ICO_NUMBER=

# ---- Social profiles and search console verification [build] ----
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Data retention [build] ----
# Days before personal data in enquiries is purged (also shown in the privacy notice).
RETENTION_DAYS=180
