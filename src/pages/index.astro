---
import site from '../../site.config.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import HeroVisual from '../components/HeroVisual.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import IntegrityBand from '../components/IntegrityBand.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Proof from '../components/Proof.astro';
import FaqList from '../components/FaqList.astro';
import GuideCard from '../components/GuideCard.astro';
import CtaBand from '../components/CtaBand.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import { services, SUPPORT_FORMATS } from '../data/services';
import { WHY_CHOOSE, HOME_FAQS } from '../data/content';
import { getGuides } from '../lib/guides';
import { graph, webPageLd, faqLd, itemListLd, absUrl, ogImageFor } from '../lib/seo';

const title = 'Assignment, Dissertation & Coursework Help';
const description =
  'One-to-one academic support for UK students: tutoring, draft feedback, policy-compliant proofreading and data analysis coaching. Free, no-obligation quote.';
const guides = (await getGuides()).slice(0, 3);

const jsonLd = graph(
  webPageLd({ path: '/', title, description, image: ogImageFor('home') }),
  itemListLd(services.map((s) => ({ name: `${s.name} support`, path: `/${s.slug}/` })), absUrl('/')),
  faqLd(HOME_FAQS, absUrl('/')),
);
---

<BaseLayout title={title} {description} path="/" og="home" {jsonLd}>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="pill"><span class="pill__dot"><Icon name="sparkle" size={12} /></span> Tutoring · Feedback · Proofreading</p>
        <h1>Academic support that makes <em>your</em> work stronger</h1>
        <p class="lead">
          One-to-one help with assignments, coursework, dissertations, research and reports. We explain, coach and give honest
          feedback on your drafts, so what you submit is better and still entirely yours.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">Get a free quote <Icon name="arrow-right" size={18} /></a>
          {
            site.contact.whatsapp ? (
              <WhatsAppLink class="btn btn--ghost">
                <Icon name="whatsapp" size={20} /> Chat on WhatsApp
              </WhatsAppLink>
            ) : (
              <a class="btn btn--ghost" href="/services/">Explore services</a>
            )
          }
        </div>
        <ul class="hero__ticks">
          <li><Icon name="check" size={18} /> Fixed quote before you commit</li>
          <li><Icon name="check" size={18} /> Reply {site.contact.replyTarget}</li>
          <li><Icon name="check" size={18} /> Within university rules</li>
        </ul>
      </div>
      <HeroVisual />
    </div>
  </section>

  <TrustStrip />

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <SectionHead eyebrow="Our services" title="Support for every kind of academic work" id="services-title">
        Choose the area you need help with. Every service is available as one-to-one tutoring, written feedback on your draft or a
        final proofread.
      </SectionHead>
      <div class="services-grid">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="why-title">
    <div class="container split">
      <div>
        <SectionHead eyebrow="Why choose us" title="Help you can trust with something this important" id="why-title">
          Good academic support should lower your stress, not add risk. Here’s what you can expect from us.
        </SectionHead>
        <div class="grid grid--2">
          {
            Object.values(SUPPORT_FORMATS).map((f) => (
              <div class="card card--plain">
                <h3>{f.name}</h3>
                <p>{f.text}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="grid">
        {
          WHY_CHOOSE.map((w) => (
            <div class="feature">
              <span class="icon-tile">
                <Icon name={w.icon} size={22} />
              </span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <IntegrityBand />

  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <SectionHead eyebrow="How it works" title="From first message to feedback in four steps" id="process-title" center>
        No accounts, no upfront payment to ask a question, and no obligation until you’ve agreed a quote.
      </SectionHead>
      <ProcessSteps />
      <p class="center mt-lg">
        <a class="btn btn--brand" href="/contact/">Start with step one <Icon name="arrow-right" size={18} /></a>
      </p>
    </div>
  </section>

  <Proof />

  <section class="section section--paper" aria-labelledby="guides-title">
    <div class="container">
      <SectionHead eyebrow="Free study guides" title="Practical study guides" id="guides-title">
        Straightforward advice on the questions students ask us most.
      </SectionHead>
      <div class="grid grid--3">
        {guides.map((g) => <GuideCard slug={g.id} title={g.data.title} summary={g.data.summary} minutes={g.minutes} />)}
      </div>
      <p class="mt-lg">
        <a class="text-link" href="/guides/">See all study guides <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container container--narrow">
      <SectionHead eyebrow="FAQs" title="Frequently asked questions" id="faq-title" center />
      <FaqList faqs={HOME_FAQS} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
