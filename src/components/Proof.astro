---
// Renders testimonials and stats only when real, consented entries exist in site.config.mjs.
import site from '../../site.config.mjs';
import SectionHead from './SectionHead.astro';

const { testimonials, stats } = site.proof;
const show = testimonials.length > 0 || stats.length > 0;
---

{
  show && (
    <section class="section section--paper" aria-labelledby="proof-title">
      <div class="container">
        <SectionHead eyebrow="Students we’ve helped" title="In their words" id="proof-title" center />
        {stats.length > 0 && (
          <div class="stats">
            {stats.map((s) => (
              <div class="stat">
                <strong>{s.value}</strong>
                <span>{s.label}</span>
              </div>
            ))}
          </div>
        )}
        {testimonials.length > 0 && (
          <div class="grid grid--3">
            {testimonials.map((t) => (
              <figure class="card quote-card">
                <blockquote>
                  <p>“{t.quote}”</p>
                </blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  {t.context}
                  {t.source && <> · {t.source}</>}
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
