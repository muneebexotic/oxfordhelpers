---
import Icon from './Icon.astro';
---

<div class="hero-visual" aria-hidden="true">
  <div class="hv-doc">
    <div class="hv-doc__top">
      <span class="hv-dot"></span><span class="hv-dot"></span><span class="hv-dot"></span>
      <span class="hv-doc__title">literature-review-draft.docx</span>
    </div>
    <div class="hv-doc__body">
      <span class="hv-h"></span>
      <span class="hv-line"></span>
      <span class="hv-line"></span>
      <span class="hv-line hv-line--mark"></span>
      <span class="hv-line hv-line--short"></span>
      <span class="hv-h hv-h--2"></span>
      <span class="hv-line"></span>
      <span class="hv-line"></span>
      <span class="hv-line hv-line--short"></span>
    </div>
  </div>
  <div class="hv-comment hv-comment--1">
    <span class="hv-avatar">T</span>
    <p><strong>Tutor comment</strong>Good synthesis. Could you weigh this study against the 2021 meta-analysis?</p>
  </div>
  <div class="hv-comment hv-comment--2"><Icon name="check" size={16} /> Harvard references consistent</div>
  <div class="hv-badge"><Icon name="calendar" size={16} /> Session booked: Thu, 4pm</div>
</div>
