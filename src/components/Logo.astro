---
import site from '../../site.config.mjs';

interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
const [first, ...rest] = site.brand.name.split(' ');
---

<a href="/" class:list={['logo', { 'logo--inverse': inverse }]} aria-label={`${site.brand.name} home`}>
  <svg class="logo__mark" width="36" height="36" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect width="48" height="48" rx="12" class="logo__tile"></rect>
    <path d="M10 16.5c4.6-2 9.1-1.8 13 .9V35c-3.9-2.6-8.4-2.9-13-1Z" fill="#fff"></path>
    <path d="M38 16.5c-4.6-2-9.1-1.8-13 .9V35c3.9-2.6 8.4-2.9 13-1Z" fill="#fff" opacity=".82"></path>
    <circle cx="24" cy="10.5" r="3.4" class="logo__spark"></circle>
  </svg>
  <span class="logo__word"><span>{first}</span>{rest.length > 0 && <span class="logo__word-2"> {rest.join(' ')}</span>}</span>
</a>
