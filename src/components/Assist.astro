---
import site from '../../site.config.mjs';
import Icon from './Icon.astro';
import EnquiryForm from './EnquiryForm.astro';
import WhatsAppLink from './WhatsAppLink.astro';

interface Props {
  service?: string;
}
const { service } = Astro.props;
---

<div class="assist" data-assist>
  <div class="assist__panel" id="assist-panel" role="dialog" aria-labelledby="assist-title" hidden>
    <div class="assist__head">
      <p id="assist-title">
        <strong>Need help?</strong>
        Tell us what you’re working on. We aim to reply {site.contact.replyTarget}.
      </p>
      <button class="assist__close" type="button" aria-label="Close" data-assist-close>
        <Icon name="x" size={18} />
      </button>
    </div>
    <div class="assist__body">
      {
        site.contact.whatsapp && (
          <>
            <WhatsAppLink service={service} class="btn btn--whatsapp btn--block">
              <Icon name="whatsapp" size={20} /> Chat on WhatsApp
            </WhatsAppLink>
            <p class="assist__or">or we can message you</p>
          </>
        )
      }
      <EnquiryForm variant="callback" id="assist-form" service={service} />
      <a class="assist__link" href="/contact/">Send a detailed enquiry instead</a>
    </div>
  </div>
  <button class="assist__fab" type="button" aria-expanded="false" aria-controls="assist-panel" data-assist-toggle>
    <Icon name="message" size={22} class="icon-open" />
    <Icon name="x" size={22} class="icon-close" />
    <span class="assist__fab-label">Need help?</span>
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-assist]');
  const panel = root?.querySelector<HTMLElement>('#assist-panel');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-assist-toggle]');

  const set = (open: boolean) => {
    if (!panel || !toggle) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) panel.querySelector<HTMLElement>('a, input, select, button:not([data-assist-close])')?.focus();
  };

  toggle?.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  root?.querySelector('[data-assist-close]')?.addEventListener('click', () => {
    set(false);
    toggle?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hidden) {
      set(false);
      toggle?.focus();
    }
  });
  // Any element with [data-open-assist] (e.g. "Request a callback" buttons) opens the panel.
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest?.('[data-open-assist]')) {
      e.preventDefault();
      set(true);
    }
  });
</script>
