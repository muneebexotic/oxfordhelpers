---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { services } from '../data/services';

interface Props {
  path: string;
  minimal?: boolean;
}
const { path, minimal = false } = Astro.props;

const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const servicesActive = path === '/services/' || services.some((s) => path === `/${s.slug}/`);
---

<header class="site-header" data-header>
  <div class="container header__inner">
    <Logo />
    {
      !minimal && (
        <>
          <nav class="nav" id="site-nav" aria-label="Main">
            <ul class="nav__list">
              <li>
                <a class="nav__link" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
              </li>
              <li>
                <a class="nav__link" href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a>
              </li>
              <li class="nav__item--menu" data-menu>
                <a class="nav__link" href="/services/" aria-current={servicesActive ? 'page' : undefined}>Services</a>
                <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="services-menu">
                  <span class="visually-hidden">Show services</span>
                  <Icon name="chevron-down" size={18} />
                </button>
                <div class="menu" id="services-menu">
                  <ul class="menu__grid">
                    {services.map((s) => (
                      <li>
                        <a class="menu__link" href={`/${s.slug}/`} aria-current={path === `/${s.slug}/` ? 'page' : undefined}>
                          <span class="menu__icon"><Icon name={s.icon} size={18} /></span>
                          <span>
                            <strong>{s.name}</strong>
                            <small>{s.cardSummary}</small>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="menu__all" href="/services/">
                    Compare all services <Icon name="arrow-right" size={16} />
                  </a>
                </div>
              </li>
              <li>
                <a class="nav__link" href="/guides/" aria-current={isCurrent('/guides/') ? 'page' : undefined}>Guides</a>
              </li>
              <li>
                <a class="nav__link" href="/contact/" aria-current={isCurrent('/contact/') ? 'page' : undefined}>Contact</a>
              </li>
            </ul>
            <a class="btn btn--primary btn--block nav__cta-mobile" href="/contact/">Get a free quote</a>
          </nav>
          <div class="header__actions">
            <a class="btn btn--primary btn--sm header__cta" href="/contact/">Get a free quote</a>
            <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu" data-burger>
              <Icon name="menu" size={22} class="icon-open" />
              <Icon name="x" size={22} class="icon-close" />
            </button>
          </div>
        </>
      )
    }
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
  const menuItem = header?.querySelector<HTMLElement>('[data-menu]');
  const menuToggle = menuItem?.querySelector<HTMLButtonElement>('.nav__toggle');

  const setNav = (open: boolean) => {
    if (!header || !burger) return;
    header.toggleAttribute('data-nav-open', open);
    burger.setAttribute('aria-expanded', String(open));
  };
  const setMenu = (open: boolean) => {
    if (!menuItem || !menuToggle) return;
    menuItem.toggleAttribute('data-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
  };

  burger?.addEventListener('click', () => setNav(burger.getAttribute('aria-expanded') !== 'true'));
  menuToggle?.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (menuItem?.hasAttribute('data-open')) {
      setMenu(false);
      menuToggle?.focus();
    } else if (header?.hasAttribute('data-nav-open')) {
      setNav(false);
      burger?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (menuItem && !menuItem.contains(e.target as Node)) setMenu(false);
  });
  // Close the drawer if the viewport grows past the mobile breakpoint.
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setNav(false));
</script>
