---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  center?: boolean;
}
const { eyebrow, title, id, center = false } = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': center }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {Astro.slots.has('default') && <p><slot /></p>}
</div>
