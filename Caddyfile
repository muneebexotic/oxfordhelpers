{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		# Pages also carry a hash-based script-src/style-src <meta> CSP generated by Astro.
		# Both policies apply, so inline code still needs a matching hash to run.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}
}

# Primary (canonical) host.
{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip

	# Fingerprinted build assets never change.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@images path /og/* /favicon.ico /favicon.svg /apple-touch-icon.png /icon-*.png
	header @images Cache-Control "public, max-age=604800"

	@html not path /_astro/* /og/* /api/* /admin/*
	header @html ?Cache-Control "public, max-age=0, must-revalidate"

	reverse_proxy app:4321
}

# www -> apex, preserving path and query (301).
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# If you also own the other domain (e.g. cambridgehelpers.co.uk while oxfordhelpers.co.uk
# is primary), uncomment and edit so it 301s to the canonical host instead of duplicating content.
# cambridgehelpers.co.uk, www.cambridgehelpers.co.uk {
# 	redir https://{$SITE_DOMAIN}{uri} permanent
# }
