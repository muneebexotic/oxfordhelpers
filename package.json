{
  "name": "academic-helpers-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Academic support website (Oxford Helpers / Cambridge Helpers) with enquiry backend, lead reporting and full SEO setup.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/seo-audit.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/entry.mjs",
    "preview": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server/entry.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "astro": "^7.4.2",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fflate": "^0.8.3"
  }
}
